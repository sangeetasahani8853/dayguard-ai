# DayGuard Environment Configuration

# Core Application Settings
APP_NAME=DayGuard
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Mode Control: Set to 'true' for deterministic hackathon demo mode, 'false' for live Swytchcode APIs
DEMO_MODE=true

# AI / LLM Integration
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Swytchcode & Integration Platform Credentials
SWYTCHCODE_API_KEY=your_swytchcode_api_key_here

# Tool API Credentials
OPENWEATHER_API_KEY=your_openweather_api_key_here
GMAIL_ACCESS_TOKEN=your_gmail_access_token_here
NOTION_TOKEN=your_notion_token_here
SLACK_TOKEN=your_slack_token_here
RESEND_API_KEY=your_resend_api_key_here

# User Contact Defaults
DEMO_USER_EMAIL=demo@dayguard.ai
